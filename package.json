{
  "name": "smart-price",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "next lint",
    "test:rust": "cargo test --manifest-path crates/stock-engine/Cargo.toml",
    "test:go": "cd services/pos-gateway && go test ./...",
    "test:python": "python3 -m unittest discover -s services/ai-analytics",
    "test:all": "npm run test:rust && npm run test:go && npm run test:python && npm run build",
    "test:polyglot": "npm run test:all",
    "test:smartprice": "node --test scripts/smartprice/*.test.cjs",
    "typecheck:smartprice": "tsc --noEmit -p tsconfig.smartprice.json",
    "prepare:ocr": "node scripts/smartprice/ocr-assets.cjs",
    "prebuild": "npm run prepare:ocr",
    "train:smartprice": "node scripts/smartprice/train-model.cjs",
    "account:smartprice": "node scripts/smartprice/create-account.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kaz": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.5.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.441.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
